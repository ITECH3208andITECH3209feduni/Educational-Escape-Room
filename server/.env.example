# University deployment template. Copy to server/.env on the university host.
# Keep the laptop's existing .env; do not overwrite it with this template.
NODE_ENV=production
PORT=5000
APP_BASE_PATH=/FEDEscape
MONGO_URI=REPLACE_WITH_EVANS_MONGODB_CONNECTION_STRING
# Confirm the final public HTTPS URL with Evan. It is also the allowed browser origin.
CLIENT_URL=https://perses.federation.edu.au/FEDEscape
# Leave empty for direct connections. Evan must set only the actual reverse proxy
# IP/CIDR(s), comma-separated. Use loopback ONLY if that proxy is on this machine.
# Never set true, 1, or a broad client network. See README-SECURITY.md.
TRUST_PROXY=
EMAIL_HOST=127.0.0.1
EMAIL_PORT=25
EMAIL_SECURE=false
EMAIL_IGNORE_TLS=true
EMAIL_FROM=no_reply@federation.edu.au
EMAIL_USER=
EMAIL_PASS=
# JWT_SECRET, JWT_EXPIRES_IN and FRONTEND_URL are no longer used.
# Session identifiers are generated with crypto.randomBytes and stored as hashes.

# Password recovery reuses these email settings and CLIENT_URL. No new secrets.
# Its email worker starts automatically with Node and uses auth_email_jobs in MongoDB.
