# University host only. Copy to server/.env and replace both placeholders.
# Keep the existing .env on your laptop; do not overwrite it with this template.
NODE_ENV=production
PORT=5000
MONGO_URI=REPLACE_WITH_EVANS_MONGODB_CONNECTION_STRING
JWT_SECRET=REPLACE_WITH_NEW_PRIVATE_RANDOM_SECRET
JWT_EXPIRES_IN=1d
# Proposed URL from Evan; confirm before deployment.
FRONTEND_URL=https://perses.federation.edu.au
CLIENT_URL=https://perses.federation.edu.au/FEDEscape
EMAIL_HOST=127.0.0.1
EMAIL_PORT=25
EMAIL_SECURE=false
EMAIL_IGNORE_TLS=true
EMAIL_FROM=no_reply@federation.edu.au
EMAIL_USER=
EMAIL_PASS=
